# MIDDLEMAN — environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is gitignored; this template is the only env file in version control.

# Supabase — Project URL and anon (publishable) key.
# Find these at https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe — publishable key only (the secret key lives as a Supabase Edge
# Function secret, never in client code). Find at:
# https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
